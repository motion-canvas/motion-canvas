{
  "name": "@motion-canvas/2d",
  "version": "4.0.0",
  "description": "A 2D renderer for Motion Canvas",
  "author": "motion-canvas",
  "homepage": "https://motion-canvas.io/",
  "bugs": "https://github.com/motion-canvas/motion-canvas/issues",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "scripts": {
    "dev": "tspc -p src/lib -w",
    "build": "npm run build-lib && npm run build-editor",
    "build-lib": "tspc -p src/lib/tsconfig.build.json",
    "build-editor": "rolldown -c rolldown.editor.config.mjs",
    "bundle": "rolldown -c rolldown.config.mjs",
    "test": "vitest"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motion-canvas/motion-canvas.git"
  },
  "files": [
    "lib",
    "editor",
    "src",
    "tsconfig.project.json"
  ],
  "devDependencies": {
    "@motion-canvas/internal": "0.0.0",
    "@motion-canvas/ui": "4.0.0",
    "clsx": "^2.1.1",
    "jsdom": "^30.0.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@motion-canvas/core": "4.0.0",
    "@preact/signals": "^2.11.2",
    "escape-string-regexp": "^5.0.0",
    "mathjax-full": "^3.2.2",
    "parse-svg-path": "^0.2.0",
    "preact": "^10.29.8"
  }
}
